{
  "name": "dsh-kanban",
  "version": "0.26.1",
  "description": "DSH 看板：以卡片为控制面、以 DSH 会话为执行面的任务看板插件。",
  "license": "MIT",
  "author": "roxorlt",
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-kanban-mcp": "./bin/kanban-mcp.mjs",
    "dsh-kanban-weixin-login": "./bin/kanban-weixin-login.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./mcp": "./lib/mcp-server.js",
    "./cloud-mcp": "./lib/cloud-mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/kanban-mcp.mjs",
    "bin/kanban-weixin-login.mjs",
    "lib/index.js",
    "lib/store.js",
    "lib/domain.js",
    "lib/routes.js",
    "lib/tools.js",
    "lib/session-binding.js",
    "lib/workspace-backfill.js",
    "lib/decisions.js",
    "lib/static.js",
    "lib/client.js",
    "lib/session-archive.js",
    "lib/session-sync.js",
    "lib/watchdog.js",
    "lib/cloud-sync-protocol.js",
    "lib/cloud-sync-client.js",
    "lib/cloud-mcp.js",
    "lib/router.js",
    "lib/im-gateway.js",
    "lib/im-notifier.js",
    "lib/weixin-channel.js",
    "lib/cc2im-bridge.js",
    "lib/mcp-server.js",
    "lib/git.js",
    "web/dist",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "dev:server": "node scripts/dev-server.mjs --port 4599",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
